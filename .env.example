MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=AgentBot
MC_VERSION=1.21.11
# Wait for in-world spawn + chunk columns before first sense (ms)
MC_SPAWN_TIMEOUT_MS=60000
# Transient multiplayer.disconnect.slow_login ("took too long to log in"): retry + optional longer protocol timeout (ms)
# See Mineflayer FAQ: checkTimeoutInterval / reconnector pattern
MC_CONNECT_MAX_ATTEMPTS=4
MC_CONNECT_RETRY_MS=2500
# Optional override; createBot defaults checkTimeoutInterval to 120000 ms if unset
# MC_CHECK_TIMEOUT_MS=180000
# Min ms between identical reflex rule takeovers (fast ticker + cycle dedupe)
# REFLEX_TAKEOVER_COOLDOWN_MS=3800

TASK_ID=demo_task
TASK_GOAL=Say hello in chat and finish

HARD_TIMEOUT_MS=10000

# LLM provider: local | openai | anthropic | deepseek | gemini | custom
LLM_PROVIDER=local
LLM_TIMEOUT_MS=15000
LLM_PROMPT_MODE=decision
LLM_PLAN_MAX_ATTEMPTS=2
SKILL_REUSE_ENABLED=true
SKILL_REUSE_MIN_SCORE=0.25

# Local-only: default skills/_next.json is the decision demo. For hello-only: LLM_INPUT_PATH=./skills/_next.hello.json
# LLM_INPUT_PATH=./skills/_next.json

# Framework safety: logging and history size control
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_PREFIX=agent
LLM_HISTORY_MAX_ITEMS=20
LLM_HISTORY_MAX_CHARS=8000
MAX_STEPS_PER_TASK=8

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Custom OpenAI-compatible API (OpenRouter, Together AI, Groq, Mistral, vLLM, Ollama, LM Studio, etc.)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=default
CUSTOM_LLM_BASE_URL=

# Personality LLM (right brain) - event-driven, uses persona.md as system prompt
# Provider: openai | anthropic | deepseek | openrouter | gemini | custom
PERSONALITY_ENABLED=false
PERSONALITY_LLM_PROVIDER=deepseek
PERSONALITY_LLM_MODEL=deepseek-chat
PERSONALITY_LLM_API_KEY=
PERSONALITY_LLM_BASE_URL=
PERSONALITY_TRIGGER_COOLDOWN_STEPS=3

# Daemon mode — continuous sense->think->act loop (bot does not quit after one task)
DAEMON_MODE=false
THINK_INTERVAL_MS=2000
REFLEX_ENABLED=true

